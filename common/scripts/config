#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers
#REMOVEME? ynh_abort_if_errors

#=================================================
# SPECIFIC GETTERS FOR TOML SHORT KEY
#=================================================

get_config_permission() {
  result=$(grep -- ".*: $role" "$install_dir/config.yaml" | sed -r "s/: $role//" | tr -d '[:blank:]' | sed '/^#/d' | tr -d '\"' | tr -d "'" | tr '\n' ',')
  echo $result
}

get__botname() {
    botname=$(ynh_app_setting_get --key botname)
    echo "${botname}"
}

get__listrelay() {
  role="relay"
  existingRelayUsers=$(get_config_permission)

  cat <<EOF
"$existingRelayUsers"
EOF
}

get__listuser() {
  role="user"
  existingUsers=$(get_config_permission)

  cat <<EOF
"$existingUsers"
EOF
}

get__listadmin() {
  role="admin"
  existingAdmins=$(get_config_permission)

  cat <<EOF
"$existingAdmins"
EOF
}

#=================================================
# SPECIFIC VALIDATORS FOR TOML SHORT KEYS
#=================================================

validate_permission_list() {
  local entries user
  IFS=',' read -r -a entries <<< "${1//\"}"
  for user in "${entries[@]}"; do
    user="${user#"${user%%[![:space:]]*}"}"
    user="${user%"${user##*[![:space:]]}"}"
    [ -z "$user" ] || valid_permission_entry "$user" || { echo "Invalid entry '$user': use *, a server name (example.org) or a Matrix ID (@user:example.org)"; return; }
  done
}
validate__listrelay() { validate_permission_list "$listrelay"; }
validate__listuser() { validate_permission_list "$listuser"; }
validate__listadmin() { validate_permission_list "$listadmin"; }

validate__avatar() {
  [[ -z "$avatar" || "$avatar" == "remove" || "$avatar" =~ ^mxc://[A-Za-z0-9.:-]+/[A-Za-z0-9_-]+$ ]] || echo "The avatar must be 'remove' or an mxc:// URI"
}

validate__displayname() {
  [[ "$displayname" != *$'\n'* ]] || echo "The display name must be on one line"
}

validate__botname() {
  [[ "$botname" =~ ^[a-z0-9._=-]+$ ]] || echo "The bot name may only contain a-z, 0-9 and . _ = -"
}

#=================================================
# SPECIFIC SETTERS FOR TOML SHORT KEYS
#=================================================

# Config panel options written in config.yaml by our own setter (short key=dotted path in config.yaml).
# Text values are quoted properly; the bridge-specific ones are in panel_text_options (_bridge.sh).
common_text_options=(
    "displayname=appservice.bot.displayname"
    "avatar=appservice.bot.avatar"
)
for kv in "${common_text_options[@]}" "${panel_text_options[@]}"; do
    eval "set__${kv%%=*}() {
        write_yaml_value '${kv#*=}' \"\$${kv%%=*}\"
        ynh_app_setting_set --key='${kv%%=*}' --value=\"\$${kv%%=*}\"
        ynh_store_file_checksum \"\$install_dir/config.yaml\"
    }"
done

# bridge.relay.enabled: YunoHost's writer only handles one level of ">", this one has two
set__enable_relaybot() {
    write_yaml_value bridge.relay.enabled "$enable_relaybot" raw
    ynh_app_setting_set --key=enable_relaybot --value="$enable_relaybot"
    ynh_store_file_checksum "$install_dir/config.yaml"
}

set__botname() {
    old_botname=$(ynh_app_setting_get --key botname)
    if [ "$botname" == "$old_botname" ] # Check to avoid updating botname when it's not needed.
    then
      return
    fi

    ynh_app_setting_set --key=botname --value="$botname"
    synapse_instance=$(ynh_app_setting_get --key synapse_instance)

    sed -i "/^    bot:/,/^    [a-z]/s/^        username:.*/        username: $botname/" "$install_dir/config.yaml"
    register_appservice
    "/opt/yunohost/matrix-$synapse_instance/update_synapse_for_appservice.sh" || ynh_die "Synapse can't restart with the appservice configuration"
    ynh_store_file_checksum "/etc/matrix-$synapse_instance/app-service/$app.yaml"
    ynh_store_file_checksum "$install_dir/config.yaml"
}

ynh_app_config_run $1
